# PEP 517 build frontend + the backend pyproject declares, hash-locked so no
# build ever resolves its own toolchain from the network (#142).
build==1.5.0
hatchling==1.31.0
# hatchling imports `editables` lazily when building an EDITABLE wheel and does
# not declare it as a dependency, so `pip install --no-build-isolation -e .`
# fails without it. Needed by CI's editable installs; inert for the release
# build's regular wheel.
editables==0.6
